{
  "name": "second-hero-data",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "capture": "tsx src/cli.ts capture",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait && tsx src/db/migrate-cli.ts && tsx src/db/seed-cli.ts",
    "test": "vitest run",
    "db:seed": "tsx src/db/seed-cli.ts",
    "replay": "tsx src/cli.ts replay",
    "validate": "tsx src/cli.ts validate",
    "sec-capture": "tsx src/cli.ts sec-capture",
    "esef-capture": "tsx src/cli.ts esef-capture",
    "esef-extract": "tsx src/cli.ts esef-extract",
    "esef-identify": "tsx src/cli.ts esef-identify",
    "quota": "tsx src/eodhd/user.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
