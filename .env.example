# API key de EODHD (nunca subirla al repo)
EODHD_API_KEY=
# Captura: tope de coste por corrida (el plan Free da 20 llamadas al día; por defecto 15), timeout en ms,
# intentos por llamada y espera entre reintentos en ms.
# EODHD_RUN_BUDGET=15
# EODHD_TIMEOUT_MS=30000
# EODHD_MAX_ATTEMPTS=1
# EODHD_RETRY_DELAY_MS=2000

# Postgres local (docker compose)
DATABASE_URL=postgres://second_hero:second_hero@localhost:5432/second_hero

# La SEC exige un User-Agent con nombre y contacto para su API (data.sec.gov)
SEC_USER_AGENT="Second hero tu-email@ejemplo.com"
